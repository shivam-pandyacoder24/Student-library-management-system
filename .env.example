# Copy this file to .env and fill in your values. Never commit .env to GitHub.

# A long random string. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Name shown in the header and in emails
LIBRARY_NAME=Campus Library

# Code that faculty and librarians must enter when they sign up
STAFF_ACCESS_CODE=change-me-too

# ---- Email for OTP codes: fill in ONE of the two options ----
# If both are empty the site runs in demo mode and shows the code on screen.

# Option A: Gmail SMTP with an App Password (works on PythonAnywhere and on your own computer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Option B: Brevo email API (works on Render's free plan, which blocks SMTP)
BREVO_API_KEY=

# The address emails come from. With Gmail, use the same Gmail address.
# With Brevo, use a sender address you verified in Brevo.
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Campus Library

# Demo data and the one-click demo buttons on the sign-in page (set to 0 for real use)
SEED_DEMO_DATA=1
ENABLE_DEMO_LOGIN=1

# Library rules
LOAN_DAYS=14
MAX_ACTIVE_LOANS=3
FINE_PER_DAY=5

# Set to 1 when the site is served over HTTPS
COOKIE_SECURE=0
